# Real corpus is fetched by scripts/fetch_real_corpus.sh (checksum-pinned), not vendored.
corpus/real/raw/*.parquet

# Run outputs — regenerated by the evaluation harness.
results/runs/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Never commit credentials.
.env
*.key

# Synthetic bundles are regenerated by corpus/synthetic/build.py
corpus/synthetic/bundles/
scripts/video/out/
scripts/video/*.mp4
